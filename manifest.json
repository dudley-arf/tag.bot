{
    "display_information": {
        "name": "Tag Bot"
    },
    "features": {
        "bot_user": {
            "display_name": "Tag Bot",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/t",
                "description": "Create a new tag",
                "usage_hint": "/t [[create | edit] <key> <value>? | [rm | remove | info | find] <key> | list]",
                "should_escape": true
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "chat:write",
                "users.profile:read",
                "users:read",
                "commands"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}