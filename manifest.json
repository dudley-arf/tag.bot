{
    "display_information": {
        "name": "Tag Bot"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": true,
            "messages_tab_enabled": false,
            "messages_tab_read_only_enabled": true
        },
        "bot_user": {
            "display_name": "Tag Bot",
            "always_online": false
        },
        "slash_commands": [
            {
                "command": "/t",
                "description": "Create a new tag",
                "usage_hint": "/t [[create | rm | remove | edit | info]? <key> <value>? | list | reminder <key> <readable_time>]",
                "should_escape": true
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "im:write",
                "chat:write",
                "commands",
                "users.profile:read",
                "users:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "app_home_opened"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}